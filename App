
import os, sqlite3
from functools import wraps
from flask import Flask, render_template, request, redirect, url_for, session, flash, jsonify
from werkzeug.security import generate_password_hash, check_password_hash

app = Flask(__name__)
app.secret_key = os.environ.get("SECRET_KEY", "dev-only-change-this")
DB = os.environ.get("DATABASE_PATH", "buildtech.db")

def get_db():
    c = sqlite3.connect(DB)
    c.row_factory = sqlite3.Row
    return c

def init_db():
    c = get_db()
    c.executescript(""" CREATE TABLE IF NOT EXISTS users ( id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, email TEXT UNIQUE NOT NULL, password_hash TEXT NOT NULL, role TEXT NOT NULL DEFAULT 'customer', created_at TEXT DEFAULT CURRENT_TIMESTAMP ); CREATE TABLE IF NOT EXISTS projects ( id INTEGER PRIMARY KEY AUTOINCREMENT, user_id INTEGER NOT NULL, name TEXT NOT NULL, area REAL NOT NULL, rate REAL NOT NULL, estimate REAL NOT NULL, created_at TEXT DEFAULT CURRENT_TIMESTAMP, FOREIGN KEY(user_id) REFERENCES users(id) ); """)
    c.commit()
    c.close()

def login_required(fn):
@wraps(fn)
    def wrapped(*args, **kwargs):
        if "user_id" not in session:
            return redirect(url_for("login"))
        return fn(*args, **kwargs)
    return wrapped

@app.route("/")
def home():
    return render_template("home.html")

@app.route("/register", methods=["GET", "POST"])
def register():
    if request.method == "POST":
        name = request.form.get("name","").strip()
        email = request.form.get("email","").strip().lower()
        password = request.form.get("password","")
        if not name or not email or len(password) < 8:
            flash("Enter your name and email, and use a password of at least 8 characters.")
            return redirect(url_for("register"))
        try:
            c = get_db()
            c.execute("INSERT INTO users(name,email,password_hash) VALUES(?,?,?)",
                      (name, email, generate_password_hash(password)))
            c.commit()
            c.close()
            flash("Registration successful. You can now log in.")
            return redirect(url_for("login"))
        except sqlite3.IntegrityError:
            flash("That email is already registered.")
    return render_template("auth.html", register=True)

@app.route("/login", methods=["GET","POST"])
def login():
    if request.method == "POST":
        email = request.form.get("email","").strip().lower()
        password = request.form.get("password","")
        c = get_db()
        user = c.execute("SELECT * FROM users WHERE email=?", (email,)).fetchone()
        c.close()
        if user and check_password_hash(user["password_hash"], password):
            session.clear()
            session["user_id"] = user["id"]
            session["name"] = user["name"]
            session["role"] = user["role"]
            return redirect(url_for("dashboard"))
        flash("Incorrect email or password.")
    return render_template("auth.html", register=False)

@app.route("/logout")
def logout():
    session.clear()
    return redirect(url_for("home"))

@app.route("/dashboard")
@login_required
def dashboard():
    c = get_db()
    projects = c.execute(
        "SELECT * FROM projects WHERE user_id=? ORDER BY id DESC",
        (session["user_id"],)
    ).fetchall()
    c.close()
    return render_template("dashboard.html", projects=projects)

@app.route("/calculator", methods=["GET","POST"])
@login_required
def calculator():
    estimate = None
    if request.method == "POST":
        name = request.form.get("name","My Project").strip()
        area = float(request.form.get("area",0))
        rate = float(request.form.get("rate",0))
        if area <= 0 or rate <= 0:
            flash("Enter positive values for area and rate.")
            return redirect(url_for("calculator"))
        estimate = area * rate
        c = get_db()
        c.execute("""INSERT INTO projects(user_id,name,area,rate,estimate) VALUES(?,?,?,?,?)""",
                  (session["user_id"], name, area, rate, estimate))
        c.commit()
        c.close()
        flash("Estimate saved to your dashboard.")
    return render_template("calculator.html", estimate=estimate)

@app.route("/api/health")
def health():
    return jsonify({"status":"ok","service":"BuildTech Africa"})

if __name__ == "__main__":
    init_db()
    app.run(host="0.0.0.0", port=int(os.environ.get("PORT",5000)), debug=False)
